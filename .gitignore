# Gradle build & cache directories
# NOTE: anchored to the repo root — a bare "build/" also ignored the
# src/main/java/.../autobuilder2/build source package, which broke CI.
.gradle/
/build/
out/
bin/

# IDE files
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Fabric Loom caches
.loom-cache/
.fabric/
run/
