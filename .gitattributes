# Auto detect text files and perform LF normalization
* text=auto
# gradlew Linux CI'da ishlashi kerak: repoda qat'iy LF, Windows bat faylida CRLF
gradlew text eol=lf
gradlew.bat text eol=crlf
# Never touch binary assets (PNG corruption = magenta textures in game)
*.png binary
*.jpg binary
*.jar binary
